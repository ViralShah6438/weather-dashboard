{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 5
    },
    "FixedWindow": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    },
    "Concurrency": {
      "PermitLimit": 50,
      "QueueLimit": 25
    }
  },
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org",
    "ApiKey": ""
  },
  "IsCacheEnabled": true
}

